# ==============================================================================
# HawkOffer Backend Configuration Template
# ==============================================================================

# Runtime Environment: development | production | testing
HAWKOFFER_ENV=development

# Logging Level: DEBUG | INFO | WARNING | ERROR
HAWKOFFER_LOG_LEVEL=INFO

# Application Data Directory (Leave blank to use platform-standard directory)
# Windows: %LOCALAPPDATA%/HawkOffer
# macOS: ~/Library/Application Support/HawkOffer
# Linux: ~/.local/share/HawkOffer
# HAWKOFFER_DATA_DIR=

# Database URL override:
# Desktop SQLite default (blank uses app data dir):
# HAWKOFFER_DATABASE_URL=sqlite+aiosqlite:///hawkoffer.db
# Production PostgreSQL (asyncpg required):
# HAWKOFFER_DATABASE_URL=postgresql+asyncpg://user:password@host:5432/hawkoffer

# API Host & Port
HAWKOFFER_API_HOST=127.0.0.1
HAWKOFFER_API_PORT=8765

# Authentication & Security
HAWKOFFER_AUTH_REQUIRED=false
# Required when HAWKOFFER_ENV=production or HAWKOFFER_AUTH_REQUIRED=true (min 32 chars):
# HAWKOFFER_JWT_SECRET_KEY=replace_with_at_least_32_characters_random_secret_key
HAWKOFFER_JWT_ALGORITHM=HS256
HAWKOFFER_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# External Cron Secret (Required in production for POST /api/v1/internal/cron/monitor)
# HAWKOFFER_CRON_SECRET=replace_with_strong_cron_secret

# Web Push Notification Credentials (VAPID)
# HAWKOFFER_VAPID_PUBLIC_KEY=
# HAWKOFFER_VAPID_PRIVATE_KEY=
HAWKOFFER_VAPID_CLAIMS_SUB=mailto:admin@hawkoffer.app

# Allowed CORS Origins (comma-separated, merges with desktop Tauri origins)
# HAWKOFFER_CORS_ORIGINS=https://hawkoffer.pages.dev,http://localhost:5173

# Internal Scheduler (set to false if using external cron scheduler)
HAWKOFFER_START_INTERNAL_SCHEDULER=true
