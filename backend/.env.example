# Environment: development | production | testing
HAWKOFFER_ENV=development

# Logging: DEBUG | INFO | WARNING | ERROR
HAWKOFFER_LOG_LEVEL=INFO

# Application Data Directory (Leave blank to use platform-standard directory)
# Windows: %LOCALAPPDATA%/HawkOffer
# macOS: ~/Library/Application Support/HawkOffer
# Linux: ~/.local/share/HawkOffer
# HAWKOFFER_DATA_DIR=

# Database URL override (Leave blank to default to SQLite in the App Data Directory)
# HAWKOFFER_DATABASE_URL=sqlite+aiosqlite:///C:/Users/username/AppData/Local/HawkOffer/hawkoffer.db

# API Host & Port (Local daemon)
HAWKOFFER_API_HOST=127.0.0.1
HAWKOFFER_API_PORT=8765
