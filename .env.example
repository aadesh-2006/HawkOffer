# ==============================================================================
# HawkOffer Environment Configuration Template
# ==============================================================================
# For local development: copy to .env and adjust variables as needed.
# For production deployment: set these as environment variables in your hosting provider
# (e.g. Render, Fly.io, Cloudflare Pages, GitHub Secrets).
# ==============================================================================

# Runtime Environment (development | production | testing)
HAWKOFFER_ENV=production

# Logging Level (DEBUG | INFO | WARNING | ERROR)
HAWKOFFER_LOG_LEVEL=INFO

# PostgreSQL Database Connection URL (Asyncpg driver required for PostgreSQL)
# Example Supabase / Neon: postgresql+asyncpg://postgres:pass@ep-cool-db.us-east-2.aws.neon.tech/neondb
# Example Local / Docker: postgresql+asyncpg://hawkoffer_user:hawkoffer_pass@db:5432/hawkoffer
# Leave blank to fall back to SQLite in local desktop AppData directory
HAWKOFFER_DATABASE_URL=postgresql+asyncpg://hawkoffer_user:replace_with_strong_database_password@db:5432/hawkoffer

# Network Binding
HAWKOFFER_API_HOST=0.0.0.0
HAWKOFFER_API_PORT=8000

# Authentication & Security
HAWKOFFER_AUTH_REQUIRED=true
# Generate with: openssl rand -hex 32
HAWKOFFER_JWT_SECRET_KEY=replace_with_at_least_32_characters_random_secret_key_for_production
HAWKOFFER_JWT_ALGORITHM=HS256
HAWKOFFER_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# External Cron Trigger Secret
# Required in production to authenticate POST /api/v1/internal/cron/monitor calls
# Generate with: openssl rand -hex 32
HAWKOFFER_CRON_SECRET=replace_with_strong_cron_secret_matching_github_actions_secret

# Web Push Notification Credentials (VAPID)
# Generate with: python -c "from cryptography.hazmat.primitives.asymmetric import ec; from cryptography.hazmat.primitives import serialization; import base64; k = ec.generate_private_key(ec.SECP256R1()); print('PRIV:', base64.urlsafe_b64encode(k.private_numbers().private_value.to_bytes(32, 'big')).decode()); print('PUB:', base64.urlsafe_b64encode(k.public_key().public_bytes(serialization.Encoding.X962, serialization.PublicFormat.UncompressedPoint)).decode())"
HAWKOFFER_VAPID_PUBLIC_KEY=
HAWKOFFER_VAPID_PRIVATE_KEY=
HAWKOFFER_VAPID_CLAIMS_SUB=mailto:admin@hawkoffer.app

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed frontend origins (e.g. Cloudflare Pages domain)
HAWKOFFER_CORS_ORIGINS=https://hawkoffer.pages.dev,http://localhost:5173

# Internal Scheduler
# Set to 'true' to run APScheduler inside the container instance (single-instance deployments)
# Set to 'false' if running multi-instance containers or using external GitHub Actions cron trigger
HAWKOFFER_START_INTERNAL_SCHEDULER=true

# Database Migrations on Startup
# Set to 'true' in docker-entrypoint to auto-run 'alembic upgrade head' before serving traffic
RUN_MIGRATIONS=true

# Docker Compose Database Service Credentials
POSTGRES_DB=hawkoffer
POSTGRES_USER=hawkoffer_user
POSTGRES_PASSWORD=replace_with_strong_database_password
